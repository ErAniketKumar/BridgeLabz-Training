@using MVC_CRUD_APP.Dto
@model UserDto

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="text-center mb-4">Login</h2>

                    <form asp-action="LoginUser">

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email"
                                name="email"
                                asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter email">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password"
                                name="password"
                                asp-for="Password"
                                   class="form-control"
                                   placeholder="Enter password">
                        </div>

                        <input type="submit"
                                class="btn btn-primary w-100" value="Submit" >
                          
                    </form> 

                </div>
            </div>

        </div>
    </div>
</div>

New User?<a asp-action="Register"> Register Here...</a>