@using MVC_CRUD_APP.Dto
@model EditProductDto
<div class="container mt-5">

    <div class="card shadow">
        <div class="card-body">

            <h2 class="mb-4">Edit Product </h2>

            <form asp-route-id="@Model.Id" asp-action="EditProduct" method="post">

                <div class="mb-3">
                    <label class="form-label">Product Name</label>
                    <input type="text"
                           class="form-control"
                           asp-for="Name"
                           name="name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control"
                              rows="3"
                              asp-for="Description"
                              name="description"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <input type="number"
                           class="form-control"
                           asp-for="Price"
                           name="price" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Color</label>
                    <input type="text"
                           class="form-control"
                           asp-for="Color"
                           name="color" />
                </div>

                <button type="submit" class="btn btn-success">
                    Update Product
                </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

</div>